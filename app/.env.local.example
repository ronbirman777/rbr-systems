# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API in the Supabase dashboard).
#
# This uses Supabase's current key format:
#   - Publishable key (sb_publishable_...) - safe for the browser, NEXT_PUBLIC_.
#   - Secret key (sb_secret_...) - server-only, NEVER prefix with NEXT_PUBLIC_,
#     never import it from a Client Component (lib/supabase/admin.ts guards this).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Temporary master-password gate for the whole platform during development/
# review (see src/lib/preview-gate). Server-only, never NEXT_PUBLIC_. Leave
# unset to disable the gate entirely - e.g. for public launch.
INNERDWES_PREVIEW_PASSWORD=
