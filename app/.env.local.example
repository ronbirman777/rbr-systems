# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API in the Supabase dashboard).
#
# This uses Supabase's current key format:
#   - Publishable key (sb_publishable_...) - safe for the browser, NEXT_PUBLIC_.
#   - Secret key (sb_secret_...) - server-only, NEVER prefix with NEXT_PUBLIC_,
#     never import it from a Client Component (lib/supabase/admin.ts guards this).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Temporary master-password gate for the whole platform during development/
# review (see src/lib/preview-gate). Server-only, never NEXT_PUBLIC_. Leave
# unset to disable the gate entirely - e.g. for public launch.
INNERDWES_PREVIEW_PASSWORD=

# Public canonical origins (see src/lib/site-url.ts) - both fall back to
# localhost when unset, so neither is required for local dev. Domain Phase 2:
# set these at DNS cutover time, not before (see that phase's report).
#   NEXT_PUBLIC_SITE_URL - the marketing/canonical origin (metadataBase,
#     sitemap.ts, robots.ts). Production value: https://innerdwes.com
#   NEXT_PUBLIC_APP_URL - the Studio origin (auth email links - signUp/
#     resendConfirmationEmail's emailRedirectTo). Production value:
#     https://app.innerdwes.com - deliberately NOT the same host as
#     NEXT_PUBLIC_SITE_URL once both domains are live.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
