{
  "_doc": "Shared access-decision vectors. Consumed by src/lib/billing/access.test.ts (TypeScript deriveSpaceAccess) AND scripts/billing-db-verify.mjs (SQL space_access_state) so the two implementations can never drift. 'now' is fixed; every offset is in hours relative to it. A null `sub` means the Space has no billing row.",
  "now": "2026-11-01T12:00:00.000Z",
  "vectors": [
    { "name": "no billing row -> undecided, legacy fallback", "sub": null,
      "expect": { "decided": false, "studio": true, "guest": null, "publish": null, "reason": "no_subscription" } },
    { "name": "healthy active subscription", "sub": { "status": "active" },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "active" } },
    { "name": "trialing is treated as active", "sub": { "status": "trialing" },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "active" } },
    { "name": "exempt, no expiry", "sub": { "status": "exempt" },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "exempt" } },
    { "name": "exempt, expires later", "sub": { "status": "exempt", "exempt_expires_in_hours": 5 },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "exempt" } },
    { "name": "exempt, expired an hour ago -> undecided", "sub": { "status": "exempt", "exempt_expires_in_hours": -1 },
      "expect": { "decided": false, "studio": true, "guest": null, "publish": null, "reason": "exemption_expired" } },
    { "name": "exempt, expiring exactly now -> expired (inclusive)", "sub": { "status": "exempt", "exempt_expires_in_hours": 0 },
      "expect": { "decided": false, "studio": true, "guest": null, "publish": null, "reason": "exemption_expired" } },
    { "name": "day 0: payment just failed, nothing suspended", "sub": { "status": "past_due", "payment_failed_hours_ago": 0 },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "payment_issue" } },
    { "name": "23h59m unresolved: Guest still up", "sub": { "status": "past_due", "payment_failed_hours_ago": 23.9833333333 },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "payment_issue" } },
    { "name": "exactly 24h: Guest unavailable (inclusive)", "sub": { "status": "past_due", "payment_failed_hours_ago": 24 },
      "expect": { "decided": true, "studio": true, "guest": false, "publish": true, "reason": "guest_suspended" } },
    { "name": "4 days: Guest down, Studio still writable", "sub": { "status": "past_due", "payment_failed_hours_ago": 96 },
      "expect": { "decided": true, "studio": true, "guest": false, "publish": true, "reason": "guest_suspended" } },
    { "name": "167h59m: Studio still writable", "sub": { "status": "unpaid", "payment_failed_hours_ago": 167.9833333333 },
      "expect": { "decided": true, "studio": true, "guest": false, "publish": true, "reason": "guest_suspended" } },
    { "name": "exactly 168h (day 7): Studio suspended", "sub": { "status": "unpaid", "payment_failed_hours_ago": 168 },
      "expect": { "decided": true, "studio": false, "guest": false, "publish": false, "reason": "studio_suspended" } },
    { "name": "day 13: still suspended, content preserved", "sub": { "status": "unpaid", "payment_failed_hours_ago": 312 },
      "expect": { "decided": true, "studio": false, "guest": false, "publish": false, "reason": "studio_suspended" } },
    { "name": "canceled -> ended", "sub": { "status": "canceled" },
      "expect": { "decided": true, "studio": false, "guest": false, "publish": false, "reason": "subscription_ended" } },
    { "name": "canceled after a payment-failure episode -> ended", "sub": { "status": "canceled", "payment_failed_hours_ago": 400 },
      "expect": { "decided": true, "studio": false, "guest": false, "publish": false, "reason": "subscription_ended" } },
    { "name": "incomplete_expired -> ended", "sub": { "status": "incomplete_expired" },
      "expect": { "decided": true, "studio": false, "guest": false, "publish": false, "reason": "subscription_ended" } },
    { "name": "cancel at period end, period ended 1h ago (inside 6h webhook slack) -> still active", "sub": { "status": "active", "cancel_at_period_end": true, "period_end_hours_from_now": -1 },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "active" } },
    { "name": "cancel at period end, period ended exactly 6h ago -> still active (boundary)", "sub": { "status": "active", "cancel_at_period_end": true, "period_end_hours_from_now": -6 },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "active" } },
    { "name": "cancel at period end, period ended 7h ago, webhook missed -> ended", "sub": { "status": "active", "cancel_at_period_end": true, "period_end_hours_from_now": -7 },
      "expect": { "decided": true, "studio": false, "guest": false, "publish": false, "reason": "subscription_ended" } },
    { "name": "cancel at period end, period still running -> active (access until period end)", "sub": { "status": "active", "cancel_at_period_end": true, "period_end_hours_from_now": 200 },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "active" } },
    { "name": "not cancelling, period_end long past but Stripe still says active -> active (Stripe is authoritative)", "sub": { "status": "active", "period_end_hours_from_now": -500 },
      "expect": { "decided": true, "studio": true, "guest": true, "publish": true, "reason": "active" } },
    { "name": "incomplete -> not active", "sub": { "status": "incomplete" },
      "expect": { "decided": true, "studio": false, "guest": false, "publish": false, "reason": "subscription_not_active" } },
    { "name": "paused -> not active", "sub": { "status": "paused" },
      "expect": { "decided": true, "studio": false, "guest": false, "publish": false, "reason": "subscription_not_active" } }
  ]
}
